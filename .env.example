# ── Resend (wysyłka maili z formularza kontaktowego) ──
# Klucz API: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Adres, na który trafiają wiadomości z formularza kontaktowego
CONTACT_TO_EMAIL=kontakt@mateuszwiewiora.pl

# Adres "From" używany do wysyłki — musi być z domeny zweryfikowanej
# w Resend (Settings → Domains). Bez weryfikacji domeny zostaw:
# onboarding@resend.dev (działa tylko w trybie testowym).
CONTACT_FROM_EMAIL=onboarding@resend.dev
