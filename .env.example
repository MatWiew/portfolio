# Resend (https://resend.com) — używane przez /api/contact do wysyłki e-maili
# z formularza kontaktowego.
RESEND_API_KEY=

# Adres, na który trafiają zgłoszenia z formularza kontaktowego.
CONTACT_RECEIVER_EMAIL=mateusz.wiewiora@outlook.com

# Adres "from" widoczny w wysyłanych mailach. Domyślnie używany jest
# onboarding@resend.dev (działa od razu, ale tylko do testów) — po
# zweryfikowaniu własnej domeny w Resend, ustaw tu np. kontakt@mateuszwiewiora.com
CONTACT_SENDER_EMAIL=kontakt@mateuszwiewiora.pl
